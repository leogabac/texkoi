<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon><tabs><tab id="texkoiTab" label="TeXKoi">
    <group id="equations" label="Equations">
      <button id="newEquation" label="New equation" size="large" onAction="OnNewEquation"/>
      <button id="editEquation" label="Edit equation" size="large" onAction="OnEditEquation"/>
    </group>
  <group id="equationHistory" label="Equation history">
    <button id="undoEquationUpdate" label="Undo equation update" onAction="OnUndoEquationUpdate"/>
    <button id="redoEquationUpdate" label="Redo equation update" onAction="OnRedoEquationUpdate"/>
  </group>
  <group id="diagnostics" label="Development"><button id="undoDiagnostics" label="Undo diagnostics" onAction="OnUndoDiagnostics"/></group></tab></tabs></ribbon>
</customUI>
